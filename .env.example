# ---------- Application ----------
# URL publique (sans slash final)
AUTH_URL=https://benevo.ioleto.fr
# Générer avec : openssl rand -base64 32
AUTH_SECRET=change-moi
AUTH_TRUST_HOST=true

# E-mail de l'administrateur : ce compte Google obtient le rôle ADMIN à la connexion
ADMIN_EMAIL=contact@ioleto.fr

# ---------- Google OAuth (voir docs/GOOGLE_OAUTH.md) ----------
AUTH_GOOGLE_ID=xxxxxxxx.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=xxxxxxxx

# ---------- Base de données ----------
POSTGRES_USER=benevo
POSTGRES_PASSWORD=change-moi-aussi
POSTGRES_DB=benevo
DATABASE_URL=postgresql://benevo:change-moi-aussi@db:5432/benevo?schema=public

# ---------- Réseau Docker de SWAG ----------
NETWORK_NAME=swag_default
