model User {
  id String @id @default(cuid())
  name String?
  firstName String?
  lastName String?
  email String? @unique
  emailVerified DateTime?
  image String?
  role Role @default(USER)
  bio String? @db.VarChar(280)
  city String? @db.VarChar(80)
  points Int @default(0)
  showOnLeaderboard Boolean @default(false)
  emailNotificationsEnabled Boolean @default(true)
  suspended Boolean @default(false)
  termsAcceptedAt DateTime?
  sensitiveConsentAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  accounts Account[]
  sessions Session[]
  memberships Membership[]
  needsCreated Need[] @relation("NeedAuthor")
  commitments Commitment[]
  swipes Swipe[]
  badges UserBadge[]
  messages Message[]
}

model Setting { key String @id value Json updatedAt DateTime @updatedAt }
model EmailLog { id String @id @default(cuid()) to String subject String status String error String? createdAt DateTime @default(now()) @@index([createdAt]) }
